{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["stateless", "stateful", "job"] },
        "env": { "type": "string" },
        "team": { "type": "string" }
      },
      "required": ["type", "env", "team"]
    },

    "image": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repo": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string" }
      }
    },

    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "health": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "path": { "type": "string" },
            "initialDelaySeconds": { "type": "integer", "minimum": 0, "maximum": 600 },
            "periodSeconds": { "type": "integer", "minimum": 1, "maximum": 300 }
          }
        }
      }
    },

    "deploy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "replicas": { "type": "integer", "minimum": 0, "maximum": 50 }
      }
    },

    "job": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "command": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "backoffLimit": { "type": "integer", "minimum": 0, "maximum": 10 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0, "maximum": 86400 }
      }
    },

    "engine": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },

    "storage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "size": { "type": "string" },
        "class": { "type": "string" }
      }
    },

    "resources": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "profile": { "type": "string" }
      },
      "required": ["profile"]
    },

    "profiles": {
      "type": "object",
      "additionalProperties": true
    },

    "expose": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "path": { "type": "string" },
        "className": { "type": "string" }
      }
    }
  },

  "allOf": [
    {
      "if": {
        "properties": { "service": { "properties": { "type": { "const": "job" } } } }
      },
      "then": {
        "required": ["job"],
        "properties": {
          "job": {
            "required": ["command"],
            "properties": {
              "command": { "minItems": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "service": { "properties": { "type": { "const": "stateful" } } } }
      },
      "then": {
        "required": ["engine", "storage", "resources"],
        "properties": {
          "storage": {
            "required": ["size"],
            "properties": {
              "size": { "pattern": "^[0-9]+(Mi|Gi|Ti)$" }
            }
          },
          "resources": {
            "properties": {
              "profile": { "pattern": "^db-" }
            }
          }
        }
      }
    }
  ]
}
