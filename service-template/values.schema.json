{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "IDP Service Contract v1",
  "type": "object",
  "required": ["service", "image", "resources"],

  "properties": {
    "service": {
      "type": "object",
      "required": ["name", "type", "env", "team"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["stateless", "stateful", "job"] },
        "env": { "type": "string", "minLength": 1 },
        "team": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },

    "image": {
      "type": "object",
      "required": ["repo", "tag"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "additionalProperties": true
    },

    "runtime": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "health": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },

    "deploy": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 1, "maximum": 50 }
      },
      "additionalProperties": true
    },

    "job": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "backoffLimit": { "type": "integer", "minimum": 0, "maximum": 10 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0, "maximum": 86400 }
      },
      "additionalProperties": true
    },

    "engine": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "enum": ["postgres", "mysql", "mssql", "redis", ""]
        },
        "version": { "type": "string" }
      },
      "additionalProperties": true
    },

    "storage": {
      "type": "object",
      "properties": {
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi|Ti)$"
        },
        "class": { "type": "string" }
      },
      "additionalProperties": true
    },

    "resources": {
      "type": "object",
      "required": ["profile"],
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["api-small", "api-medium", "db-small", "db-medium", "job-small"]
        }
      },
      "additionalProperties": true
    },

    "expose": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "path": { "type": "string" },
        "className": { "type": "string" }
      },
      "additionalProperties": true
    },

    "profiles": { "type": "object" }
  },

  "allOf": [
    {
      "if": {
        "properties": { "service": { "properties": { "type": { "const": "stateless" } } } }
      },
      "then": {
        "required": ["runtime"],
        "properties": {
          "runtime": { "required": ["port"] }
        }
      }
    },
    {
      "if": {
        "properties": { "service": { "properties": { "type": { "const": "job" } } } }
      },
      "then": {
        "required": ["job"],
        "properties": {
          "job": { "required": ["command"] }
        }
      }
    },
    {
      "if": {
        "properties": { "service": { "properties": { "type": { "const": "stateful" } } } }
      },
      "then": {
        "required": ["engine", "storage"],
        "properties": {
          "engine": { "required": ["name"] },
          "storage": { "required": ["size"] }
        }
      }
    },

    {
      "if": {
        "properties": {
          "engine": {
            "properties": {
              "name": { "enum": ["postgres", "mysql", "mssql"] }
            }
          }
        }
      },
      "then": {
        "properties": {
          "resources": {
            "properties": {
              "profile": { "pattern": "^db-" }
            }
          }
        }
      }
    },

    {
      "if": {
        "properties": { "service": { "properties": { "type": { "const": "job" } } } }
      },
      "then": {
        "properties": {
          "resources": {
            "properties": {
              "profile": { "pattern": "^job-" }
            }
          }
        }
      }
    },

    {
      "if": {
        "properties": { "service": { "properties": { "type": { "const": "stateless" } } } }
      },
      "then": {
        "properties": {
          "resources": {
            "properties": {
              "profile": { "pattern": "^api-" }
            }
          }
        }
      }
    }
  ]
}
